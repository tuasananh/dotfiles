#!/usr/bin/env python3
import os
import sys
import shutil
import json
import hashlib
import subprocess
import argparse
import time
import difflib
import pwd
import grp
from datetime import datetime

# Formatting / Colors
C_BOLD = "\033[1m"
C_GREEN = "\033[92m"
C_RED = "\033[91m"
C_YELLOW = "\033[93m"
C_BLUE = "\033[94m"
C_CYAN = "\033[96m"
C_GRAY = "\033[90m"
C_RESET = "\033[0m"

# Path Setup
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
SOURCE_DIR = os.path.join(SCRIPT_DIR, "system")
TARGET_ROOT = "/"
STATE_DIR = "/var/lib/syssync"
STATE_FILE = os.path.join(STATE_DIR, "state.json")
BACKUP_DIR = "/var/backup/syssync"


def print_err(msg):
    print(f"{C_RED}{C_BOLD}Error:{C_RESET} {msg}", file=sys.stderr)


def print_warn(msg):
    print(f"{C_YELLOW}{C_BOLD}Warning:{C_RESET} {msg}")


def print_info(msg):
    print(f"{C_BLUE}{C_BOLD}Info:{C_RESET} {msg}")


def print_success(msg):
    print(f"{C_GREEN}{C_BOLD}Success:{C_RESET} {msg}")


def get_sha256(filepath):
    if not os.path.exists(filepath) or os.path.isdir(filepath):
        return None
    sha256_hash = hashlib.sha256()
    try:
        with open(filepath, "rb") as f:
            for byte_block in iter(lambda: f.read(4096), b""):
                sha256_hash.update(byte_block)
        return sha256_hash.hexdigest()
    except Exception:
        return None


def load_state():
    if not os.path.exists(STATE_FILE):
        return {}
    try:
        with open(STATE_FILE, "r") as f:
            return json.load(f)
    except Exception as e:
        print_warn(f"Failed to read state file, starting fresh. Details: {e}")
        return {}


def save_state(state):
    # Ensure state directory exists
    if not os.path.exists(STATE_DIR):
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            os.chmod(STATE_DIR, 0o755)
        except PermissionError:
            # If not root, ignore saving state silently or write to temp
            return
    try:
        with open(STATE_FILE, "w") as f:
            json.dump(state, f, indent=2)
        os.chmod(STATE_FILE, 0o644)
    except PermissionError:
        pass


def get_source_files():
    tracked_files = []
    if not os.path.exists(SOURCE_DIR):
        return []
    for root, _, files in os.walk(SOURCE_DIR):
        for file in files:
            # Skip stow config file or other dotfile noise
            if file in (".stow-local-ignore", ".gitattributes", ".gitignore"):
                continue
            abs_src = os.path.join(root, file)
            rel_path = os.path.relpath(abs_src, SOURCE_DIR)
            tracked_files.append(rel_path)
    return sorted(tracked_files)


def get_file_status(rel_path, state):
    src_path = os.path.join(SOURCE_DIR, rel_path)
    tgt_path = os.path.join(TARGET_ROOT, rel_path)

    src_hash = get_sha256(src_path)
    tgt_hash = get_sha256(tgt_path)

    src_mode = os.stat(src_path).st_mode & 0o777 if os.path.exists(src_path) else None
    tgt_mode = os.stat(tgt_path).st_mode & 0o777 if os.path.exists(tgt_path) else None

    state_entry = state.get(rel_path)
    if isinstance(state_entry, dict):
        last_hash = state_entry.get("hash")
        last_mode = state_entry.get("mode")
    else:
        last_hash = state_entry
        last_mode = None

    if not os.path.exists(src_path):
        if tgt_hash is not None:
            return "DELETED_IN_SRC", src_hash, tgt_hash, last_hash
        return "UNKNOWN", src_hash, tgt_hash, last_hash

    if tgt_hash is None:
        return "NEW_FILE", src_hash, tgt_hash, last_hash

    if src_hash == tgt_hash and src_mode == tgt_mode:
        return "IN_SYNC", src_hash, tgt_hash, last_hash

    if last_hash is None:
        # No history, but files differ (in hash or mode)
        return "DIFFERS_NO_STATE", src_hash, tgt_hash, last_hash

    # Check if local changed
    local_changed = False
    if src_hash != last_hash:
        local_changed = True
    if last_mode is not None and src_mode != last_mode:
        local_changed = True

    # Check if target changed
    target_changed = False
    if tgt_hash != last_hash:
        target_changed = True
    if last_mode is not None and tgt_mode != last_mode:
        target_changed = True

    # If neither reported a change but they differ:
    if not local_changed and not target_changed:
        return "DIFFERS_NO_STATE", src_hash, tgt_hash, last_hash

    if local_changed and not target_changed:
        return "OUT_OF_SYNC_LOCAL", src_hash, tgt_hash, last_hash

    if target_changed and not local_changed:
        return "OUT_OF_SYNC_EXTERNAL", src_hash, tgt_hash, last_hash

    # Both have changed and differ from last sync
    return "CONFLICT", src_hash, tgt_hash, last_hash


def backup_file(tgt_path, rel_path):
    if not os.path.exists(tgt_path):
        return
    if not os.path.exists(BACKUP_DIR):
        os.makedirs(BACKUP_DIR, exist_ok=True)
        os.chmod(BACKUP_DIR, 0o700)

    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    safe_name = rel_path.replace("/", "_")
    backup_path = os.path.join(BACKUP_DIR, f"{safe_name}.{timestamp}.bak")

    try:
        shutil.copy2(tgt_path, backup_path)
        # Ensure backup is secure (root only)
        os.chmod(backup_path, 0o600)
    except Exception as e:
        print_warn(f"Failed to backup {tgt_path}: {e}")


def notify_user(title, message, is_error=False):
    # Try to find active GUI user and DBUS path
    uids = []
    if os.path.exists("/run/user"):
        try:
            uids = [d for d in os.listdir("/run/user") if d.isdigit()]
        except Exception:
            pass
    if not uids:
        uids = ["1000"]

    for uid in uids:
        bus_path = f"/run/user/{uid}/bus"
        if os.path.exists(bus_path):
            try:
                username = pwd.getpwuid(int(uid)).pw_name
            except Exception:
                username = "tuasananh"

            urgency = "critical" if is_error else "normal"
            icon = "dialog-error" if is_error else "preferences-system"

            env = os.environ.copy()
            env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={bus_path}"

            try:
                subprocess.run(
                    [
                        "sudo",
                        "-u",
                        username,
                        "notify-send",
                        "-a",
                        "SysSync",
                        "-u",
                        urgency,
                        "-i",
                        icon,
                        title,
                        message,
                    ],
                    env=env,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            except Exception:
                pass


def do_push(rel_path, state, force=False):
    src_path = os.path.join(SOURCE_DIR, rel_path)
    tgt_path = os.path.join(TARGET_ROOT, rel_path)

    status, src_hash, tgt_hash, last_hash = get_file_status(rel_path, state)

    if status == "IN_SYNC":
        return True, "Already in sync"

    if status in ("OUT_OF_SYNC_EXTERNAL", "CONFLICT", "DIFFERS_NO_STATE") and not force:
        if src_hash == tgt_hash:
            pass
        else:
            return (
                False,
                f"Refused to overwrite external system modification ({status})",
            )

    # Proceed with Sync
    # 1. Ensure target directory exists
    tgt_dir = os.path.dirname(tgt_path)
    if not os.path.exists(tgt_dir):
        try:
            os.makedirs(tgt_dir, exist_ok=True)
            # Set parent directories to 755 root:root
            curr = tgt_dir
            while curr != "/":
                try:
                    shutil.chown(curr, user="root", group="root")
                    os.chmod(curr, 0o755)
                except Exception:
                    pass
                curr = os.path.dirname(curr)
        except Exception as e:
            return False, f"Failed to create directory {tgt_dir}: {e}"

    # 2. Check for existing target permissions to preserve them
    existing_mode = None
    if os.path.exists(tgt_path) and not os.path.islink(tgt_path):
        try:
            existing_mode = os.stat(tgt_path).st_mode & 0o777
        except Exception:
            pass

    # 3. Backup if target exists
    if os.path.exists(tgt_path):
        backup_file(tgt_path, rel_path)

    # 4. Copy file
    try:
        # Remove target if it is a symlink (cleanup Stow)
        if os.path.islink(tgt_path):
            os.unlink(tgt_path)

        shutil.copy2(src_path, tgt_path)

        # 5. Enforce root ownership and correct permissions
        shutil.chown(tgt_path, user="root", group="root")

        # Sync permissions to match the source file permissions
        src_mode = (
            os.stat(src_path).st_mode & 0o777 if os.path.exists(src_path) else 0o644
        )
        os.chmod(tgt_path, src_mode)

        # Update State
        new_hash = get_sha256(tgt_path)
        tgt_mode = (
            os.stat(tgt_path).st_mode & 0o777 if os.path.exists(tgt_path) else None
        )
        state[rel_path] = {"hash": new_hash, "mode": tgt_mode}
        return True, "Synced successfully"

    except PermissionError:
        return False, "Permission denied (Run with sudo)"
    except Exception as e:
        return False, str(e)


def do_pull(rel_path, state, force=False):
    src_path = os.path.join(SOURCE_DIR, rel_path)
    tgt_path = os.path.join(TARGET_ROOT, rel_path)

    status, src_hash, tgt_hash, last_hash = get_file_status(rel_path, state)

    if status == "IN_SYNC":
        return True, "Already in sync"

    if status in ("OUT_OF_SYNC_LOCAL", "CONFLICT") and not force:
        if src_hash == tgt_hash:
            pass
        else:
            return False, f"Refused to overwrite local dotfile modification ({status})"

    if tgt_hash is None:
        return False, "System file does not exist to pull from"

    # Proceed with Pull (Target -> Source)
    src_dir = os.path.dirname(src_path)
    if not os.path.exists(src_dir):
        os.makedirs(src_dir, exist_ok=True)

    try:
        shutil.copy2(tgt_path, src_path)
        # Ensure the user tuasananh owns the dotfile
        try:
            shutil.chown(src_path, user="tuasananh", group="tuasananh")
        except Exception:
            pass

        tgt_mode = (
            os.stat(tgt_path).st_mode & 0o777 if os.path.exists(tgt_path) else None
        )
        state[rel_path] = {"hash": tgt_hash, "mode": tgt_mode}
        return True, "Pulled successfully"
    except Exception as e:
        return False, str(e)


def cmd_status(args):
    state = load_state()
    files = get_source_files()

    if not files:
        print_info("No system configuration files found in system/ folder.")
        return

    print(f"\n{C_BOLD}{C_CYAN}--- System Configuration Status ---{C_RESET}")
    print(f"{C_GRAY}Source:{C_RESET} {SOURCE_DIR}")
    print(f"{C_GRAY}Target:{C_RESET} {TARGET_ROOT}\n")

    status_colors = {
        "IN_SYNC": C_GREEN,
        "NEW_FILE": C_CYAN,
        "OUT_OF_SYNC_LOCAL": C_YELLOW,
        "OUT_OF_SYNC_EXTERNAL": C_RED,
        "DIFFERS_NO_STATE": C_YELLOW,
        "CONFLICT": C_RED + C_BOLD,
    }

    status_labels = {
        "IN_SYNC": "IN SYNC",
        "NEW_FILE": "NEW FILE",
        "OUT_OF_SYNC_LOCAL": "MODIFIED LOCAL",
        "OUT_OF_SYNC_EXTERNAL": "MODIFIED SYSTEM",
        "DIFFERS_NO_STATE": "OUT OF SYNC",
        "CONFLICT": "CONFLICT",
    }

    # Pre-calculate file statuses and find maximum label width of printed items
    file_statuses = []
    for f in files:
        status, _, _, _ = get_file_status(f, state)
        label = status_labels.get(status, status)
        file_statuses.append((f, status, label))

    max_label_len = (
        max(len(label) for _, _, label in file_statuses) if file_statuses else 0
    )

    for f, status, label in file_statuses:
        color = status_colors.get(status, C_RESET)
        target_path = os.path.join(TARGET_ROOT, f)
        print(
            f"  [{color}{label:^{max_label_len}}{C_RESET}]  {f}  {C_GRAY}→{C_RESET}  {target_path}"
        )
    print()


def cmd_diff(args):
    state = load_state()
    files = get_source_files()

    diff_count = 0
    for f in files:
        status, _, _, _ = get_file_status(f, state)
        if status == "IN_SYNC":
            continue

        src_path = os.path.join(SOURCE_DIR, f)
        tgt_path = os.path.join(TARGET_ROOT, f)

        src_lines = []
        if os.path.exists(src_path):
            with open(src_path, "r", errors="replace") as file_in:
                src_lines = file_in.readlines()

        tgt_lines = []
        if os.path.exists(tgt_path):
            with open(tgt_path, "r", errors="replace") as file_in:
                tgt_lines = file_in.readlines()

        diff = difflib.unified_diff(
            tgt_lines,
            src_lines,
            fromfile=f"Target: {tgt_path}",
            tofile=f"Source: {src_path}",
            lineterm="",
        )

        diff_list = list(diff)
        src_mode = (
            os.stat(src_path).st_mode & 0o777 if os.path.exists(src_path) else None
        )
        tgt_mode = (
            os.stat(tgt_path).st_mode & 0o777 if os.path.exists(tgt_path) else None
        )

        if diff_list or (src_mode != tgt_mode):
            diff_count += 1
            print(f"\n{C_BOLD}{C_BLUE}Diff for {f}:{C_RESET}")
            print(f"{C_GRAY}{'=' * 60}{C_RESET}")
            if src_mode != tgt_mode:
                src_oct = oct(src_mode)[2:] if src_mode is not None else "None"
                tgt_oct = oct(tgt_mode)[2:] if tgt_mode is not None else "None"
                print(
                    f"{C_YELLOW}Permissions differ: Target ({tgt_oct}) != Source ({src_oct}){C_RESET}"
                )
            for line in diff_list:
                if line.startswith("+"):
                    print(f"{C_GREEN}{line}{C_RESET}")
                elif line.startswith("-"):
                    print(f"{C_RED}{line}{C_RESET}")
                elif line.startswith("@@"):
                    print(f"{C_CYAN}{line}{C_RESET}")
                else:
                    print(line)

    if diff_count == 0:
        print_success("All system configuration files are completely in sync.")


def cmd_push(args):
    if os.geteuid() != 0:
        print_err(
            "Pushing system configs requires root privileges. Please run with sudo."
        )
        sys.exit(1)

    state = load_state()
    files = get_source_files()

    success_count = 0
    failure_count = 0

    for f in files:
        ok, msg = do_push(f, state, force=args.force)
        if ok:
            if "successfully" in msg:
                print_success(f"{f}: {msg}")
                success_count += 1
        else:
            print_err(f"{f}: {msg}")
            failure_count += 1

    save_state(state)

    if failure_count > 0:
        print_warn(
            f"Push completed with {failure_count} failures. In-sync items: {success_count}."
        )
    elif success_count > 0:
        print_success("Push completed successfully. All files synced.")
    else:
        print_info("Nothing to push. All files already in sync.")


def cmd_pull(args):
    state = load_state()
    files = get_source_files()

    success_count = 0
    failure_count = 0

    for f in files:
        ok, msg = do_pull(f, state, force=args.force)
        if ok:
            if "successfully" in msg:
                print_success(f"{f}: {msg}")
                success_count += 1
        else:
            print_err(f"{f}: {msg}")
            failure_count += 1

    try:
        save_state(state)
    except PermissionError:
        print_warn(
            "Dotfiles were updated, but could not write to state file (run as root to update state)."
        )

    if failure_count > 0:
        print_warn(
            f"Pull completed with {failure_count} failures. In-sync items: {success_count}."
        )
    elif success_count > 0:
        print_success("Pull completed successfully. Dotfiles updated.")
    else:
        print_info("Nothing to pull. Dotfiles already up to date.")


def main():
    parser = argparse.ArgumentParser(
        description="syssync: A safe, robust sync utility for system dotfiles (etc/ and boot/)"
    )

    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # Status
    subparsers.add_parser(
        "status", help="Show status of all tracked system configuration files"
    )

    # Diff
    subparsers.add_parser(
        "diff", help="Show differences between dotfiles and the live system"
    )

    # Push
    push_parser = subparsers.add_parser(
        "push", help="Push system dotfiles into the live system"
    )
    push_parser.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="Force overwrite modified system files",
    )

    # Pull
    pull_parser = subparsers.add_parser(
        "pull", help="Pull system files into the dotfiles repository"
    )
    pull_parser.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="Force overwrite modified local dotfiles",
    )

    # Watch
    subparsers.add_parser(
        "watch", help="Watch for changes in system dotfiles and sync them in real-time"
    )

    # Install Service
    subparsers.add_parser(
        "install-service",
        help="Install and start the syssync background daemon service",
    )

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(0)

    commands = {
        "status": cmd_status,
        "diff": cmd_diff,
        "push": cmd_push,
        "pull": cmd_pull,
    }

    commands[args.command](args)


if __name__ == "__main__":
    main()
