{
  "custom/arch": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "btw"
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "format-icons": {
      "urgent": "",
      "active": "",
      "default": ""
    }
  },
  "hyprland/window": {
    "format": "{}",
    "rewrite": {
      "": "Desktop",
      "zsh": "Terminal",
      "~": "Terminal"
    }
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": " ",
      "deactivated": " "
    }
  },
  "custom/backlight": {
    "exec": "~/.config/khypr/scripts/get_brightness.sh",
    "return-type": "json",
    "format": "<span size='large' rise='-512' letter_spacing='12288'>{icon}</span>{percentage}%",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "on-scroll-up": "~/.config/khypr/scripts/brightness.sh up",
    "on-scroll-down": "~/.config/khypr/scripts/brightness.sh down",
    "reverse-scrolling": true,
    "tooltip-format": "Screen Brightness"
  },
  /*-------------------
	    Output device
	-------------------*/
  "tray": {
    "spacing": 5,
    "cursor": true
  },
  "pulseaudio#output": {
    "format": "<span letter_spacing='2048'>{icon}</span>{volume}%",
    // "format-bluetooth":
    "format-muted": "<span letter_spacing='2048'>{icon}</span>{volume}%",
    // "format-source":
    // "format-source-muted":
    "format-icons": {
      "default": [" ", " ", " "],
      "default-muted": " ",
      "headphone": "󰋋 ",
      "headphone-muted": "󰟎 ",
      "headset": "󰋎 ",
      "headset-muted": "󰋐 "
    },
    // "rotate":
    // "states":
    // "min-length": 6,
    // "max-length": 6,
    // "align":
    // "justify":
    // "scroll-step":
    "on-click": "~/.config/khypr/scripts/volume.sh output mute",
    // "on-click-middle":
    // "on-click-right":
    // "on-update":
    "on-scroll-up": "~/.config/khypr/scripts/volume.sh output up",
    "on-scroll-down": "~/.config/khypr/scripts/volume.sh output down",
    // "smooth-scrolling-threshold":
    // "tooltip":
    "tooltip-format": "<b>Output Device</b>: {desc}",
    // "max-volume":
    // "ignored-sinks":
    "reverse-scrolling": true
    // "reverse-mouse-scrolling":
    // "menu":
    // "menu-file":
    // "menu-actions":
    // "expand":
  },
  /*----------------
	    Microphone
	----------------*/
  "pulseaudio#input": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " {volume}%",
    "on-click": "~/.config/khypr/scripts/volume.sh input mute",
    "on-scroll-up": "~/.config/khypr/scripts/volume.sh input up",
    "on-scroll-down": "~/.config/khypr/scripts/volume.sh input down",
    "tooltip-format": "<b>Input Device</b>: {desc}",
    "reverse-scrolling": true
  },
  "network": {
    "format-wifi": "<span letter_spacing='2048'>{icon}</span>{essid}",
    "format-icons": ["󰤯 ", "󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "],
    "format-ethernet": "󰊗 {ipaddr}/{cidr}",
    "format-disconnected": "⚠ Disconnected",
    "tooltip-format": "{ifname} via {gwaddr}",
    "on-click": "~/.config/khypr/launchers/launch-network-manager.sh"
  },
  "bluetooth": {
    "format": "<span letter_spacing='8192'></span>{status}",
    "format-disabled": "", // an empty format will hide the module
    "format-connected": " {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "~/.config/khypr/launchers/launch-terminal.sh --class floating-center-window -e bluetoothctl"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span letter_spacing='8192'>{icon}</span>{capacity}%",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": [
        "󰢟 ",
        "󰢜 ",
        "󰂆 ",
        "󰂇 ",
        "󰂈 ",
        "󰢝 ",
        "󰂉 ",
        "󰢞 ",
        "󰂊 ",
        "󰂋 ",
        "󰂅 "
      ]
    }
  },
  "clock": {
    "format": "<span rise='512'> </span><span rise='-512'>{:%Y/%m/%d %H:%M}</span>",
    "tooltip-format": "<tt><big>{calendar}</big></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#fab387'><b>{}</b></span>", // peach
        "days": "<span color='#cdd6f4'><b>{}</b></span>", // text
        "weeks": "<span color='#94e2d5'><b>W{}</b></span>", // teal
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>", // yellow
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>" // red (makes today pop)
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_down",
      "on-scroll-down": "shift_up"
    }
  }
}
